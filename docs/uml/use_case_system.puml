@startuml
left to right direction

skinparam usecase {
    BackgroundColor white
    BorderColor black
    ArrowColor black
}

skinparam actor {
    BackgroundColor white
    BorderColor black
}

' Define the System Boundary
rectangle "Minesweeper Game Logic" as System <<Block>> {

    usecase "Process User Input" as UC_Input
    usecase "Update Game State" as UC_State
    usecase "Render Graphics" as UC_Render
    usecase "Execute IR Protocol" as UC_Proto
}

' Define Actors (Hardware Devices)
actor "Wii Nunchuck" as Nunchuck <<Device>>
actor "LCD Screen" as LCD <<Device>>
actor "IR Emitter" as IREmitt <<Device>>
actor "IR Receiver" as IRRecv <<Device>>

' Define Relationships
Nunchuck --> UC_Input : Provides Data\n(X/Y, C, Z)

UC_Input ..> UC_State : <<include>>

UC_State ..> UC_Render : <<include>>
UC_Render --> LCD : Sends Pixel Data

UC_State <.. UC_Proto : <<include>>

' IR Interactions
UC_Proto --> IREmitt : Transmit Packet
IRRecv --> UC_Proto : Trigger Interrupt / Data

note right of UC_Proto
  Handles encoding/decoding
  NEC-based protocol
end note

@enduml